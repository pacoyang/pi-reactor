{
  "name": "pi-reactor",
  "version": "0.1.4",
  "description": "Self-hosted agent event loop for the pi coding agent: cron and webhook triggers, a durable queue with spend caps, and outbound notifications to Telegram/Slack.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "ai-agent",
    "autonomous-agents",
    "self-hosted",
    "job-queue",
    "cron",
    "webhook",
    "telegram"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-reactor": "./dist/cli.js"
  },
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ],
    "skills": [
      "./skills/operate-pi-reactor/SKILL.md"
    ]
  },
  "files": [
    "dist",
    "skills",
    "INSTALL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/!(*.contract).test.ts\"",
    "test:contract": "node --test --test-timeout=120000 \"test/*.contract.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run build && npm run check"
  },
  "dependencies": {
    "croner": "^9.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
